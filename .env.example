# For Docker Compose: copy to .env and fill in your lab's settings.
LAB_DEMO=false
LAB_ADMIN_PASSWORD=replace-with-a-long-random-password
LAB_ACCESS_CODE=replace-with-a-shared-lab-access-code
LAB_PUBLIC_URL=https://inventory.your-lab.org
LAB_SMTP_HOST=smtp.your-provider.org
LAB_SMTP_PORT=587
LAB_SMTP_SECURITY=starttls
LAB_SMTP_FROM=inventory@your-lab.org
LAB_SMTP_USERNAME=inventory@your-lab.org
LAB_SMTP_PASSWORD=replace-with-an-smtp-password
